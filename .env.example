# LLM provider configuration ("gemini" or "groq")
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Required when LLM_PROVIDER="gemini"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# GROQ_API_KEY: Optional free-tier alternative when LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Classical check thresholds
FUZZY_NAME_THRESHOLD="85"
SHARPNESS_MIN_VARIANCE="100.0"

# SQLite storage for anonymized check session summaries & evaluation metrics
SCHEMESATHI_DB_PATH="db/schemesathi.db"

# APP_URL: Runtime URL injected by host environment
APP_URL="MY_APP_URL"
